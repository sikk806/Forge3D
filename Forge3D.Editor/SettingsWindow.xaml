<Window x:Class="Forge3D.Editor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="420" Width="420" WindowStartupLocation="CenterOwner"
        Background="#101316" Foreground="#EEF4F5">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDE6E8"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#141B20"/>
            <Setter Property="Foreground" Value="#F7FAFA"/>
            <Setter Property="BorderBrush" Value="#344650"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#24313A"/>
            <Setter Property="Foreground" Value="#EEF4F5"/>
            <Setter Property="BorderBrush" Value="#3E505B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding HeaderGeneral}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            <TextBlock Text="{Binding LabelLanguage}"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"/>
            <TextBlock Text="{Binding LabelDefaultWorkspace}"/>
            <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"/>

            <TextBlock Text="{Binding HeaderSettingsSimulation}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,18,0,3"/>
            <TextBlock Text="{Binding LabelFixedTimestep}"/>
            <TextBox Text="{Binding FixedTimestep, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}"/>
            <TextBlock Text="{Binding LabelGravityY}"/>
            <TextBox Text="{Binding GravityY, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>

            <TextBlock Text="{Binding LabelNavigation}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,18,0,3"/>
            <TextBlock Text="{Binding LabelDefaultMobility}"/>
            <ComboBox ItemsSource="{Binding MobilityModels}" SelectedItem="{Binding SelectedMobilityModel}"/>
            <TextBlock Text="{Binding LabelDefaultPlanner}"/>
            <ComboBox ItemsSource="{Binding Planners}" SelectedItem="{Binding SelectedPlanner}"/>
            <TextBlock Text="{Binding LabelGridResolution}"/>
            <TextBox Text="{Binding GridResolution, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding ButtonClose}" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>
